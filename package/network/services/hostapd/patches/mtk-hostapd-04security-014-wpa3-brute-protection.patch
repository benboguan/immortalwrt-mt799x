+	if (ret != WLAN_STATUS_SUCCESS) {
+		if (ret == SAE_KEY_MISMATCH) {
+			u8 notify_mac[ETH_ALEN];
+#ifdef CONFIG_MTK_IEEE80211BE
+			if (pasn->sae->dot11MultiLinkActivated)
+				os_memcpy(notify_mac, pasn->sae->peer_ml_ie->ml_addr, ETH_ALEN);
+			else
+#endif
+			os_memcpy(notify_mac, sta->addr, ETH_ALEN);
+			wpa_msg(hapd->msg_ctx, MSG_INFO, AP_STA_POSSIBLE_SAE_PSK_MISMATCH MACSTR, MAC2STR(notify_mac));
+			hostapd_ubus_notify(hapd, "key-mismatch", notify_mac);
+			}
 		wpa_printf(MSG_DEBUG, "PASN: SAE failed checking confirm");
 		return -1;
 	}
