--- hostapd.orig/src/ap/ieee802_11.c
+++ hostapd/src/ap/ieee802_11.c
@@ -1655,6 +1655,7 @@ static void handle_auth_sae(struct hosta
 			goto remove_sta;
 		if (sta->sae->state >= SAE_CONFIRMED ||
