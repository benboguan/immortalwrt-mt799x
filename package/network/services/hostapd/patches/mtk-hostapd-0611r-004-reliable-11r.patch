@@ -4373,3 +4379,99 @@ bool rsn_is_snonce_cookie(const u8 *snon
 		WPA_GET_BE24(pos + 3) == 0x000029;
 }
 
+int is_ft_akm(const unsigned char *akm)
+{
+	unsigned char ft_akm_types[4] = {3, 4, 9, 25};
+	unsigned char rsn_oui[3] = {0x00, 0x0f, 0xac};
+	unsigned char ft_akm_cnt = 4, i = 0;
+
+	if (memcmp(akm, rsn_oui, 3) != 0)
+		return 0;
+	for (i = 0; i < ft_akm_cnt; i++) {
+		if (akm[3] == ft_akm_types[i])
+			return 1;
+	}
+
+	return 0;
+}
+
+int is_non_ft_akm(const unsigned char *akm)
+{
+	unsigned char non_ft_akm_types[4] = {1, 2, 8, 24};
+	unsigned char rsn_oui[3] = {0x00, 0x0f, 0xac};
+	unsigned char non_ft_akm_cnt = 4, i = 0;
+
+	if (memcmp(akm, rsn_oui, 3) != 0)
+		return 0;
+	for (i = 0; i < non_ft_akm_cnt; i++) {
+		if (akm[3] == non_ft_akm_types[i])
+			return 1;
+	}
+
+	return 0;
+}
+
+void remove_akm_from_rsn_ie(unsigned char *rsn_ie, size_t *rsn_ie_len,
+		unsigned char remove_type_ft)
+{
+	unsigned char *ptr = NULL, *end = NULL, *akm_list = NULL, *akm = NULL;
+	unsigned short pairwise_count = 0, akm_count = 0, new_akm_count = 0;
+	unsigned char len = 0, akm_bytes_removed = 0, new_len = 0;
+	unsigned char removed = 0, i = 0;
+	unsigned char new_akm_list[128] = {0}, org_len = *rsn_ie_len;
+
+	len = rsn_ie[1];
+	ptr = rsn_ie + 2;
+	end = rsn_ie + org_len;
+
+    /*skip Version (2 bytes), Group Cipher Suite (4 bytes)*/
+	ptr += 2 + 4;
+
+	/*skip Pairwise Cipher Suite Count (2 bytes) and list*/
+	pairwise_count = ptr[0] | (ptr[1] << 8);
+	ptr += 2 + pairwise_count * 4;
+
+    /*AKM Suite Count*/
+	akm_count = ptr[0] | (ptr[1] << 8);
+	if (akm_count >= 0xff)
+		return;
+	akm_list = ptr + 2;
+	for (i = 0; i < akm_count; i++) {
+		akm = akm_list + i * 4;
+		/* for normal sta, sta only see non-ft akm matched in beacon/probr rsp
+		 * here need remove all ft akm in rsnie
+		 */
+		if (remove_type_ft && is_ft_akm(akm)) {
+			removed = 1;
+			continue;
+		}
+		/* for reliable 11r sta, sta replace non-ft akm matched in beacon/probr rsp to ft akm
+		 * here need remove all non-ft akm matched in rsnie
+		 */
+		if (!remove_type_ft && is_non_ft_akm(akm)) {
+			removed = 1;
+			continue;
+		}
+		memcpy(new_akm_list + new_akm_count * 4, akm, 4);
+		new_akm_count++;
+	}
+
+	if (!removed)
+		return;
+
+    /*update AKM Suite Count and List*/
+	ptr[0] = new_akm_count & 0xFF;
+	ptr[1] = (new_akm_count >> 8) & 0xFF;
+	memcpy(akm_list, new_akm_list, new_akm_count * 4);
+    /*compute new len*/
+	akm_bytes_removed = (akm_count - new_akm_count) * 4;
+	new_len = len - akm_bytes_removed;
+	rsn_ie[1] = new_len;
+	*rsn_ie_len = org_len - akm_bytes_removed;
+
+	/*move fields that after akm list ahead*/
+	if (akm_bytes_removed > 0 && (akm_list + akm_count * 4 < end))
+		memmove(akm_list + new_akm_count * 4,
+			akm_list + akm_count * 4,
+			end - (akm_list + akm_count * 4));
+}
