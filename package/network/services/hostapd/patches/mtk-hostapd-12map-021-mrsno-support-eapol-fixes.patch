+		.eapol_failure_report = hostapd_wpa_auth_eapol_failure_report,
 		.set_eapol = hostapd_wpa_auth_set_eapol,
 		.get_eapol = hostapd_wpa_auth_get_eapol,
 		.get_eapol_for_event = hostapd_wpa_auth_get_eapol_for_event,
