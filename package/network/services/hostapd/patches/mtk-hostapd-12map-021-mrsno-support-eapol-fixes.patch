--- hostapd.orig/src/ap/wpa_auth_glue.c
+++ hostapd/src/ap/wpa_auth_glue.c
@@ -306,6 +306,35 @@ static void hostapd_wpa_auth_psk_failure
 	hostapd_ubus_notify(hapd, "key-mismatch", addr);
 }
 
+static void hostapd_wpa_auth_eapol_failure_report(void *ctx, struct wpabuf *eapol_buf, const u8 *addr, int frame)
+{
+	struct hostapd_data *hapd = ctx;
+	u16 frame_type, frame_len;
+	u8 status_code, reason;
+	char *hex_buf = NULL;
+
+	reason = WLAN_REASON_PREV_AUTH_NOT_VALID;
+	status_code = WLAN_STATUS_UNSPECIFIED_FAILURE;
+	if (frame == 2)
+		frame_type = EAPOL_MSG_2;
+	else
+	 	frame_type = EAPOL_MSG_4;
+	frame_len = eapol_buf->used * 2 + 1;
+	hex_buf = malloc(eapol_buf->used * 2 + 1);
+	if (hex_buf == NULL) {
+		wpa_printf(MSG_ERROR, "Memory allocation failed for hex buff");
+		return;
+	}
+	wpa_hexdump_buf(MSG_ERROR, "EAPOL buffer : ",eapol_buf);
+	wpa_snprintf_hex(hex_buf, frame_len, eapol_buf->buf, eapol_buf->used);
+
+	wpa_msg(hapd->msg_ctx, MSG_INFO,
+		WPS_EVENT_EAPOL_FAIL_BUFFER
+		MACSTR " status_code=%d reason=%d type=%d len=%d buf=%s",
+		MAC2STR(addr), status_code, reason, frame_type, frame_len, hex_buf);
+	os_free(hex_buf);
+	wpa_printf(MSG_INFO, "Shiv : buffer sent!");
+}
 
