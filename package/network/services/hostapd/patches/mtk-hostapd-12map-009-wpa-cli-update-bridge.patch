+#ifdef CONFIG_MTK_MAP
+static int wpa_supplicant_ctrl_iface_update_bridge(
+	struct wpa_supplicant *wpa_s, char *ifname)
+{
+	wpa_printf(MSG_DEBUG, "CTRL_IFACE: UPDATE_BRIDGE bride name=%s", ifname);
+
+	if (ifname && os_strlen(ifname) > 0) {
+		if (wpa_supplicant_update_bridge_ifname(wpa_s, ifname) < 0)
+			return -1;
+	} else {
+		if (wpa_supplicant_update_bridge_ifname(wpa_s, NULL) < 0)
+			return -1;
+	}
+	return 0;
+}
+#endif /* CONFIG_MTK_MAP */
 
