+int ml_group_deinit_for_reconfig(struct hostapd_data *hapd)
+{
+	struct wpa_ml_group *ml_group;
+	size_t i;
+
+	if (!hapd)
+		return -1;
+
+	ml_group = hapd->ml_group;
+	if (!ml_group || (ml_group->ml_link_num <= 0))
+		return -1;
+
+	for (i = 0; i < ml_group->ml_link_num; i++) {
+		struct wpa_ml_link *link;
+		struct hostapd_data *link_hapd;
+
+		link = &ml_group->links[i];
+		link_hapd = link->ctx;
+
+		if (link_hapd == NULL)
+			continue;
+
+		if (link_hapd != hapd)
+			continue;
+
+		wpa_printf(MSG_INFO, "ML: mlo reconfig Remove link %u", link->link_id);
+
+		if (i < (ml_group->ml_link_num - 1)) {
+			os_memmove(&ml_group->links[i],
+				&ml_group->links[i + 1],
+				sizeof(struct wpa_ml_link) * (ml_group->ml_link_num - i - 1));
+		}
+
+		ml_group->ml_link_num--;
+		os_memset(&ml_group->links[ml_group->ml_link_num], 0, sizeof(struct wpa_ml_link));
+
+		if (ml_group->ml_link_num == 0)
+			os_free(ml_group);
+
+		hapd->ml_group = NULL;
+
+		break;
+	}
+
+	return 0;
+}
