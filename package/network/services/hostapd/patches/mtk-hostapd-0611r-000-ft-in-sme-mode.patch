Index: hostapd/src/drivers/driver_nl80211.c
===================================================================
--- hostapd.orig/src/drivers/driver_nl80211.c
+++ hostapd/src/drivers/driver_nl80211.c
@@ -4464,6 +4464,44 @@ static int nl80211_set_mesh_config(void
 }
 #endif /* CONFIG_MESH */
 
+#ifdef HOSTAPD_11R_SUPPORT
+static int nl80211_set_ft_ie(struct wpa_driver_nl80211_data *drv,
+					struct wpa_driver_ap_params *params)
+{
+	struct ap_11r_params* ft_params;
+	struct nl_msg *msg = NULL;
+	struct nlattr *attr;
+	int ret = -1;
+
+	wpa_printf(MSG_INFO, "nl80211_set_ft_ie");
+
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+			nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+			nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD, MTK_NL80211_VENDOR_SUBCMD_SET_FT))
+			goto fail;
+
+	attr = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA);
+	if (!attr)
+		goto fail;
+
+	if (nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_FTIE, sizeof(struct ap_11r_params),
+	     			(void *)(&params->ft_params)))
+		goto fail;
+
+	nla_nest_end(msg, attr);
+
+	ret = send_and_recv_msgs(drv, msg, NULL, NULL, NULL, NULL);
+	if (ret)
+		wpa_printf(MSG_DEBUG, "nl80211: vendor command failed err=%d",
+				  ret);
+	return ret;
+
+	fail:
+		nlmsg_free(msg);
+		return ret;
+}
+#endif
+
 
 static int nl80211_put_beacon_rate(struct nl_msg *msg, u64 flags, u64 flags2,
 				   struct wpa_driver_ap_params *params)
@@ -4730,6 +4768,10 @@ static int wpa_driver_nl80211_set_ap(voi
 	struct wpa_driver_mesh_bss_params mesh_params;
 #endif /* CONFIG_MESH */
 
+#ifdef HOSTAPD_11R_SUPPORT
+	nl80211_set_ft_ie(drv, params);
+#endif
+
 	beacon_set = params->reenable ? 0 : bss->beacon_set;
 
 	wpa_printf(MSG_DEBUG, "nl80211: Set beacon (beacon_set=%d)",
@@ -8957,6 +8999,17 @@ static int wpa_driver_nl80211_probe_req_
 				   NULL, 0, false) < 0)
 		goto out_err;
 
+#ifdef HOSTAPD_11R_SUPPORT
+	if (nl80211_register_frame(bss, bss->nl_preq,
+				   (WLAN_FC_TYPE_MGMT << 2) |
+				   (WLAN_FC_STYPE_REASSOC_REQ << 4),
+				   NULL, 0, false) < 0)
+		goto out_err;
+	else
+		wpa_printf(MSG_DEBUG, "nl80211: Enable REASSOC REQ Handle "
+		   "reporting nl_mgmt=%p", bss->nl_mgmt);
+#endif
+
 	nl80211_register_eloop_read(&bss->nl_preq,
 				    wpa_driver_nl80211_event_receive,
 				    bss->nl_cb, 0);
