 	} else if (os_strncmp(buf, "ANQP_GET ", 9) == 0) {
 		if (get_anqp(wpa_s, buf + 9) < 0)
 			reply_len = -1;
+#ifdef CONFIG_PE
+	} else if (os_strncmp(buf, "GAS_RAND_MAC_ENABLE ", 20) == 0) {
