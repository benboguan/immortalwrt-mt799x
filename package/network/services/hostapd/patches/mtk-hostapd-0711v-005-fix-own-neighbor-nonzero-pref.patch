+int hostapd_neighbor_check_other_mac_presence(char *nei_buf, size_t buflen, u8 *own_addr,
+	u8 *own_addr_link0, u8 *own_addr_link1)
+{
+	size_t len = 0;
+	int own_mac = 0;
+	u8 shift_len = 0;
+
+	while (len < buflen) {
+		/* Guard: ensure Length field is readable before accessing nei_buf[len+1] */
+		if (len + 1 >= buflen)
+			break;
+
+		if (nei_buf[len] == WLAN_EID_NEIGHBOR_REPORT) {
+			/* Guard: ensure MAC address bytes are within buffer bounds */
+			if (len + 2 + ETH_ALEN > buflen)
+				break;
+
+			if (os_memcmp(&nei_buf[len + 2], own_addr, ETH_ALEN) == 0 ||
+					os_memcmp(&nei_buf[len + 2], own_addr_link0, ETH_ALEN) == 0 ||
+					os_memcmp(&nei_buf[len + 2], own_addr_link1, ETH_ALEN) == 0)
+				own_mac = 1;
+			else
+				own_mac = 0;
+
+			shift_len = (u8)nei_buf[len + 1];
+
+			if (own_mac) {
+				len += shift_len + 2;
+				continue;
+			} else {
+				break;
+			}
+		} else {
+			/* Non-target EID: skip to the next TLV element (Type + Length + Value).
+			 * Without this else branch, len is never advanced when the EID does not
+			 * match, causing an infinite loop — the root cause of this Coverity finding. */
+			shift_len = (u8)nei_buf[len + 1];
+
+			/* Guard: a zero-length field would stall the loop at the same offset */
+			if (shift_len == 0)
+				break;
+
+			len += shift_len + 2;
+		}
+	}
+
+	return own_mac;
+}
