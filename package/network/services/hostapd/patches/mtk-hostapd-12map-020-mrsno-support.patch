+static void ieee802_1x_save_eapol_new(struct sta_info *sta, const u8 *buf,
+				  size_t len, enum frame_encryption encrypted)
+{
+	if (sta->eapol_for_event) {
+		wpabuf_free(sta->eapol_for_event->buf);
+	} else {
+		sta->eapol_for_event =
+			os_malloc(sizeof(*sta->eapol_for_event));
+		if (!sta->eapol_for_event)
+			return;
+	}
+
+	sta->eapol_for_event->buf = wpabuf_alloc_copy(buf, len);
+	if (!sta->eapol_for_event->buf) {
+		os_free(sta->eapol_for_event);
+		sta->eapol_for_event = NULL;
+		return;
+	}
+
+}
