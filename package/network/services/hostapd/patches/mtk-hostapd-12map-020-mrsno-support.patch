+static struct wpabuf * hostapd_wpa_auth_get_eapol_for_event(void *ctx, const u8 *addr)
+{
+	struct hostapd_data *hapd = ctx;
+	struct sta_info *sta = ap_get_sta(hapd, addr);
+	if (sta == NULL)
+		wpa_printf(MSG_ERROR, "[%s-%d] addr = " MACSTR, __func__, __LINE__, MAC2STR(addr));
+	if (sta && sta->eapol_sm)
+		wpa_printf(MSG_ERROR, "[%s-%d] addr = " MACSTR, __func__, __LINE__, MAC2STR(addr));
+
+	if (sta == NULL) {
+		wpa_printf(MSG_ERROR, "[%s-%d] addr = " MACSTR, __func__, __LINE__, MAC2STR(addr));
+		return NULL;
+	}
+	if (!sta->eapol_for_event) {
+		wpa_printf(MSG_ERROR, "[%s-%d] eapol_for_event is null = " MACSTR, __func__, __LINE__, MAC2STR(addr));
+		return NULL;
+	}
+
+	if (sta->eapol_for_event->buf)
+		wpa_hexdump_buf(MSG_ERROR,"eapol hexdump glue file",sta->eapol_for_event->buf);
+
+	return sta->eapol_for_event->buf;
+
+}
 
