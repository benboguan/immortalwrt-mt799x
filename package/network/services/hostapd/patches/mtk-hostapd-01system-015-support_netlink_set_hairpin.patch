+static int nl80211_put_brport_attr(struct nl_msg *msg, enum drv_br_port_attr attr,
+				   unsigned int val)
+{
+	switch (attr) {
+	case DRV_BR_PORT_ATTR_PROXYARP:
+		return nla_put_u8(msg, IFLA_BRPORT_PROXYARP_WIFI, val);
+	case DRV_BR_PORT_ATTR_HAIRPIN_MODE:
+		return nla_put_u8(msg, IFLA_BRPORT_MODE, val ? 1 : 0);
+	default:
+		wpa_printf(MSG_ERROR, "nl80211: Unknown bridge port attribute %d", attr);
+		return -EINVAL;
+	}
+}
 
