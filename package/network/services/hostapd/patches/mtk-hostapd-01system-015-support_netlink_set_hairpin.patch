+static int wpa_driver_br_port_set_attr(void *priv, enum drv_br_port_attr attr,
+					unsigned int val)
+{
+	struct i802_bss *bss = priv;
+	int ret;
+
+	ret = wpa_driver_br_port_set_attr_netlink(bss, attr, val);
