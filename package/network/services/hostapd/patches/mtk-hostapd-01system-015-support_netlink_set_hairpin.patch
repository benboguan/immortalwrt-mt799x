+static int wpa_driver_br_port_set_attr_netlink(struct i802_bss *bss,
+					       enum drv_br_port_attr attr,
+					       unsigned int val)
+{
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl_msg *msg;
+	struct nlattr *protinfo;
+	struct ifinfomsg ifm;
+	int ret = -1;
+
+	if (!drv->rtnl_sk) {
+		wpa_printf(MSG_DEBUG, "nl80211: NETLINK_ROUTE socket not available");
+		return -1;
+	}
+
+	if (bss->br_ifindex == 0) {
+		wpa_printf(MSG_DEBUG, "nl80211: Interface not in bridge");
+		return -1;
+	}
+
+	msg = nlmsg_alloc_simple(RTM_SETLINK, NLM_F_REQUEST | NLM_F_ACK);
+	if (!msg)
+		return -ENOMEM;
+
+	os_memset(&ifm, 0, sizeof(ifm));
+	ifm.ifi_family = AF_BRIDGE;
+	ifm.ifi_index = bss->ifindex;
+
+	if (nlmsg_append(msg, &ifm, sizeof(ifm), NLMSG_ALIGNTO) < 0)
+		goto out;
+
+	protinfo = nla_nest_start(msg, IFLA_PROTINFO);
+	if (!protinfo)
+		goto out;
+
+	ret = nl80211_put_brport_attr(msg, attr, val);
+	if (ret < 0)
+		goto out;
+
+	nla_nest_end(msg, protinfo);
+
+	ret = nl_send_auto_complete(drv->rtnl_sk, msg);
+	if (ret < 0) {
+		wpa_printf(MSG_DEBUG, "nl80211: Failed to send netlink message: %s",
+			   nl_geterror(ret));
+		goto out;
+	}
+
+	ret = nl_wait_for_ack(drv->rtnl_sk);
+	if (ret == 0) {
+		wpa_printf(MSG_DEBUG, "nl80211: Bridge port attr %d set to %u via netlink",
+			   attr, val);
+	} else {
+		wpa_printf(MSG_DEBUG, "nl80211: Failed to set bridge port attr %d via netlink: %s",
+			   attr, nl_geterror(ret));
+	}
+
+out:
+	nlmsg_free(msg);
+	return ret;
+}
