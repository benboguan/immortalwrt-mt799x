+static int nl80211_pidof(const char *exe)
+{
+	DIR *dir;
+	struct dirent *de;
+	char path[PATH_MAX], comm[64], *nl;
+	FILE *fp;
+	int pid = 0;
+
+	if (!(dir = opendir("/proc")))
+		return 0;
+
+	while (!pid && (de = readdir(dir)) != NULL)
+	{
+		if (de->d_name[0] < '0' || de->d_name[0] > '9')
+			continue;
+
+		snprintf(path, sizeof(path), "/proc/%s/comm", de->d_name);
+
+		if (!(fp = fopen(path, "r")))
+			continue;
+
+		if (fgets(comm, sizeof(comm), fp))
+		{
+			if ((nl = strchr(comm, '\n')) != NULL)
+				*nl = '\0';
+
+			if (!strcmp(comm, exe))
+				pid = atoi(de->d_name);
+		}
+
+		fclose(fp);
+	}
+
+	closedir(dir);
+
+	return pid;
+}
