 	attr.dev_id = -1;
 	attr.port_num = -1;
@@ -114,6 +118,9 @@
 	int ret = 0;
 	int addr = 0;
 	unsigned int phy_speed = 0;
+
+	if (!is_chip_valid())
+		return -1;
 
 	ret = mt753x_get_port_status(port, &status);
 	if ((ret == 0) && (!status)) {
